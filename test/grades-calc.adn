;--

    A simple grades calculator program showing each
    of the base features in the language!

    This is just a first real draft <3

--;

local max_grade = 100
local passing_grade = 60

local grades = [50, 74, 80, 41, 100]

local student_name = "Lily"

function avg -> (grades) { ; Overrides "grades" in the previous scope.
    local result = 0
    for grade in grades {
        result += grade
    }

    <- result / #grades
}

if avg <- (grades) >= passing_grade {
    print <- (`${student_name} is passing!`)
}
