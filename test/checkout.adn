local shop_name = "Corner Market"
local item_names = ["Coffee", "Bread", "Apples"]
local unit_prices = [4.50, 2.25, 1.75]
local quantities = [2, 1, 4]

local discount_rate = 0.10
local tax_rate = 0.08

local subtotal = unit_prices[1] * quantities[1] +
				 unit_prices[2] * quantities[2] +
				 unit_prices[3] * quantities[3]
local discount = subtotal * discount_rate
local after_discount = subtotal - discount
local is_large_order = after_discount >= 10.0
local is_small_order = !is_large_order
local arithmetic_sample = 10 / 2 + 5 % 2 + 2 ^ 2
local negative_adjustment = -0.50

function count_items -> (items) {
	<- #items
}

function total_with_tax {
	<- after_discount + after_discount * tax_rate
}

local order_count = count_items <- (item_names)
local total_due = total_with_tax <- ()

if total_due > 50.0 {
	print <- (`${shop_name}: large order, total ${total_due}`)
}

if total_due == 0.0 {
	print <- ("The order is empty.")
}

if total_due !== 0.0 {
	print <- ('Order received.')
}

if is_small_order {
	print <- (`${shop_name}: small order`)
}

if {
	print <- (`${order_count} items in the cart`)
}

for item_name in item_names {
	print <- (`Adding ${item_name} to the receipt`)
}

for index = 1, order_count {
	local line_total = unit_prices[index] * quantities[index]
	print <- (`Line ${index}: ${line_total}`)
}

local scan_index = 1
while scan_index <= order_count {
	print <- (`Scanning ${item_names[scan_index]}`)
	scan_index++
}

if false {
	scan_index--
	--scan_index
	subtotal += 1.0
	subtotal -= 1.0
	subtotal *= 1.0
	subtotal /= 1.0
	subtotal %= 1.0
	subtotal = subtotal + 1.0
	unit_prices[1] = unit_prices[1] - negative_adjustment
}
